# Copy this file to Twilio.env and replace the values with your real credentials.
# Do not commit your real secrets to source control.

TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=+12345678900
# Required for browser video consultations. Create these in Twilio Console > Video.
TWILIO_API_KEY_SID=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_KEY_SECRET=your_twilio_api_key_secret_here
BASE_URL=https://your-public-domain.ngrok.app
APP_NAME=Orbix Health
CALL_EMERGENCY_NUMBER=112
DEBUG_MODE=false
